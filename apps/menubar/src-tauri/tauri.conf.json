{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merit",
  "version": "0.1.0",
  "identifier": "dev.merit.harness",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "pnpm -w app:ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "Productivity",
    "shortDescription": "Evidence of how you work",
    "copyright": "Apache-2.0"
  }
}
