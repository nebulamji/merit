{
  "name": "merit",
  "private": true,
  "version": "0.1.0",
  "description": "Merit harness: signed, Bitcoin-anchored evidence of how work was done.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/site/tsconfig.worker.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "site:build": "node apps/site/build.mjs",
    "site:deploy": "node apps/site/build.mjs && cd apps/site && wrangler deploy",
    "app:ui": "esbuild apps/menubar/src/dashboard.ts --bundle --format=iife --platform=browser --tsconfig=tsconfig.json --outfile=apps/menubar/ui/dashboard.js --log-level=warning",
    "app:build": "pnpm app:ui && pnpm --filter @merit/menubar tauri build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.24.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.14.4",
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "@noble/curves": "^1.6",
    "@noble/hashes": "^1.5"
  }
}
