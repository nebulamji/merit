{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@merit/spec": ["packages/spec/src/index.ts"],
      "@merit/capture": ["packages/capture/src/index.ts"],
      "@merit/attest": ["packages/attest/src/index.ts"],
      "@merit/verify": ["packages/verify/src/index.ts"],
      "@merit/review": ["packages/review/src/index.ts"],
      "@merit/score": ["packages/score/src/index.ts"]
